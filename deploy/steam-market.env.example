# /etc/steam-market.env  (chmod 600)  --- loaded by systemd via EnvironmentFile
PORT=8787
BIND=127.0.0.1
TZ=Asia/Shanghai
# outbound proxy for steamcommunity.com:
#   unset          -> auto-detect env/system proxy, fall back to direct
#   none           -> never use a proxy, always direct
#   http://IP:PORT -> always use this proxy
STEAM_PROXY=none
